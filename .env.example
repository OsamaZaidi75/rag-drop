# RAGDrop environment. Copy to .env and fill in the keys — never commit
# the filled-in file. Only names here, no values.

# NVIDIA API key (LLM answers + embeddings). Same key for both.
NVIDIA_API_KEY=

# Qdrant Cloud cluster (the only vector store). Both required.
QDRANT_URL=
QDRANT_API_KEY=

# Optional overrides (defaults shown):
# DATA_DIR=./data/runtime
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# EMBEDDING_DIM=2048
# SESSION_TTL_DAYS=7
# MAX_SESSIONS=5
# MAX_FILE_BYTES=26214400
# MAX_CHUNKS_PER_SESSION=10000

# Local dev / tests only — NEVER set in production:
# RAGDROP_FAKE_STORE=1  (in-memory vector store instead of Qdrant)
# RAGDROP_FAKE_AI=1     (deterministic fake embedder + LLM)
